{
  "build": {
    "exclude": [
      "**/*.map",
      "**/*.ts",
      "**/*.tsx",
      "**/.DS_Store",
      "**/Thumbs.db"
    ],
    "include": [
      "module.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "scripts/**",
      "styles/**",
      "templates/**",
      "lang/**",
      "packs/**",
      "assets/**",
      "data/**",
      "fonts/**",
      "icons/**",
      "media/**",
      "sounds/**",
      "ui/**",
      "vendor/**"
    ],
    "preBuild": [],
    "sourceExclude": [
      ".git/**",
      ".runyth-template-source/**",
      "dist/**",
      "node_modules/**",
      "coverage/**",
      ".nyc_output/**",
      ".cache/**",
      "*.log",
      ".env",
      ".env.*",
      "**/.DS_Store",
      "**/Thumbs.db"
    ]
  },
  "module": {
    "kind": "runtime",
    "publicApi": true,
    "repository": "Runyth/foundry-runyth-npc-button",
    "systemNeutral": false
  },
  "runtimeKit": {
    "managed": false
  },
  "schemaVersion": 1,
  "sync": {
    "exclude": []
  },
  "template": {
    "repository": "Runyth/template-foundry-module",
    "source": false,
    "version": "1.1.6"
  },
  "validation": {
    "allowFindings": [
      {
        "path": "scripts/filters.mjs",
        "reason": "Audited: static template markup; labels pass through the module escape helpers.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/complementary-module-colors.mjs",
        "reason": "Audited: static markup and internal numeric palette values only.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/actor-directory.mjs",
        "reason": "Audited: static markup; escaped names/ids via escapeAttribute.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/actor-portrait-button.mjs",
        "reason": "Audited: static icon markup and localized labels.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/manual-copy.mjs",
        "reason": "Audited: static markup; escaped values.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/npc-dashboard.mjs",
        "reason": "Audited: static templates plus escapeAttribute/escapeHtml on every dynamic value and localized labels.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/npc-help.mjs",
        "reason": "Audited: static help markup and localized labels.",
        "rule": "unsafe-inner-html"
      },
      {
        "path": "scripts/ui/npc-import-preview.mjs",
        "reason": "Audited: static markup; escaped import preview values.",
        "rule": "unsafe-inner-html"
      }
    ],
    "forbidPrivateFoundryApis": true,
    "forbidSourceMaps": true,
    "requireLocaleParity": true,
    "requireRepositoryUrls": true,
    "requireVersionParity": true,
    "requiredLocales": [
      "de",
      "en"
    ]
  }
}
